# blue-prism-v7-mcp — deployment configuration template.
#
# Copy to .env (gitignored) or set these in the MCP client's server config.
# Full reference and the day-one verification checklist: DEPLOYMENT.md.

# --- Connection (required in live mode; the server refuses to start without
# --- them, naming every missing variable) -----------------------------------
# The v7 API and the Blue Prism Authentication Server are separate services,
# typically separate hosts/ports — hence two URLs.
BP_API_BASE_URL=https://bp-api.example.com/api/v7
BP_AUTH_URL=https://bp-auth.example.com
# OAuth2 client-credentials for a dedicated service account (see DEPLOYMENT.md
# for the permission mapping). Posted form-encoded to <BP_AUTH_URL>/connect/token.
BP_CLIENT_ID=
BP_CLIENT_SECRET=
# Token scope. The API requires "bp-api bpserver" (default); set empty to omit
# the scope param so the Authentication Server grants the client's full scope set.
#BP_TOKEN_SCOPE=bp-api bpserver

# --- Data source -------------------------------------------------------------
# live (default) — the v7 REST API. mock — lean in-memory fixtures, no estate,
# no credentials: evaluate the full tool surface in any MCP client risk-free.
# demo — the same offline client, seeded with a larger populated estate (varied
# queue health, in-flight/stale sessions, a failed schedule, months of session
# history) — best for a live walkthrough or demo.
#BP_DATA_SOURCE=live

# --- TLS / timeouts / caching -------------------------------------------------
#BP_API_VERIFY_SSL=true
#BP_API_TIMEOUT=30
#BP_API_CACHE_TTL=30

# --- Pagination (v7 is token-paged everywhere; the rest is an escape hatch for
# --- gateways/proxies that reshape responses) ---------------------------------
#BP_API_PAGING_MODE=token
#BP_API_PAGE_SIZE=1000
#BP_API_MAX_PAGES=1000
#BP_API_PAGE_SIZE_PARAM=itemsPerPage
#BP_API_PAGE_TOKEN_PARAM=pagingToken
#BP_API_PAGE_OFFSET_PARAM=startIndex

# --- Transport governance (bounding the load on your estate) -------------------
# All OFF by default: an unconfigured server emits exactly what it always has.
# There are no recommended numbers — they depend on your concurrent users, poll
# cadence, and the application server's headroom. Measure first with
# BPClient.transport_stats(), then set a ceiling above your steady state.
# See the tuning notes in DEPLOYMENT.md.
#
# Sustained request ceiling against the API host (0 disables the limiter), and
# the idle headroom a sudden fan-out may spend at once.
#BP_API_MAX_REQUESTS_PER_SECOND=0
#BP_API_MAX_BURST=10
# Ceiling on requests in flight at once (0 = unbounded). This is what stops a
# wide host thread pool fanning out into the application server all at once.
#BP_API_MAX_CONCURRENCY=0
# ONE end-to-end budget for waiting on a request slot — the concurrency slot and
# the rate token together, not each in turn. Spent → TransportBudgetExceeded,
# never a dropped or unboundedly queued request.
#BP_API_LIMITER_TIMEOUT=10
# Connection-pool size. 0 leaves requests' own default; the effective size is
# raised to MAX_CONCURRENCY where that is larger, so the pool is never the
# narrower limit (above it, requests churns connections and re-handshakes TLS).
#BP_API_POOL_MAXSIZE=0
# Retries per READ for 429 (honouring Retry-After in either RFC 7231 form) and
# the transient gateway statuses 502/503/504, with jittered exponential backoff.
# Writes are never retried — a repeated start_process is a second live run. The
# 401 token-refresh retry is separate and always active.
#BP_API_MAX_RETRIES=0
#BP_API_RETRY_BASE_DELAY=0.5
# Ceiling on any single retry wait, whatever its source. The estate gets to ask
# us to wait; it does not get to decide how long we hang. Load-bearing for an
# absolute Retry-After date, whose arithmetic subtracts THIS host's clock from
# the Blue Prism server's — ordinary NTP drift is seconds, but a host that has
# lost time sync (or a gateway writing local time as GMT) can be hours out.
#BP_API_RETRY_MAX_DELAY=60

# --- PII scrubbing -------------------------------------------------------------
# null (default) — pass-through, an explicit deployment decision.
# regex          — zero-dependency UK FS patterns (NI numbers, sort codes,
#                  account numbers, Luhn-checked PANs, emails, phones).
# presidio       — NER via the [pii] extra + a spaCy model; fails loud at
#                  startup if either is missing.
#BP_PII_BACKEND=null
#BP_PII_SPACY_MODEL=en_core_web_sm
# Deployment-specific identifiers, prepended so they beat the built-ins on
# overlapping spans. JSON array of {"name", "pattern"}; malformed input
# refuses to start.
#BP_PII_CUSTOM_PATTERNS=[{"name": "CLIENT_REF", "pattern": "CLT-\\d{8}"}]

# --- Tier 3 control tools (off by default) -------------------------------------
# Enabling actions REQUIRES an audit path — JSON lines, one per invocation,
# attempt recorded before the write is issued. No default, no opt-out.
# Action tools also default to dry_run=true at call time.
#BP_ENABLE_ACTIONS=false
#BP_AUDIT_LOG_PATH=/var/log/blue-prism-v7-mcp/audit.jsonl
